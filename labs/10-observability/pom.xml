<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.agentic.handbook</groupId>
    <artifactId>agentic-developer-handbook</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>lab-10-observability</artifactId>
  <packaging>jar</packaging>

  <name>Lab 10 - Observability</name>
  <description>A minimal, in-memory trace model, structured log, and metrics around the Lab 07 bounded agent, so one run can be reconstructed after the fact: which model calls, which decisions, which tool calls, and why it stopped.</description>

  <dependencies>
    <!-- Official Google Gen AI Java SDK, only for the optional live run,
         kept at the same version as the other canonical labs. No dependency is
         added for observability itself: traces, logs, and metrics are plain Java. -->
    <dependency>
      <groupId>com.google.genai</groupId>
      <artifactId>google-genai</artifactId>
      <version>1.72.0</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.1.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.4</version>
        <configuration>
          <mainClass>dev.agentic.handbook.labs.observability.ObservabilityExample</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
