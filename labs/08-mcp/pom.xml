<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.agentic.handbook</groupId>
    <artifactId>agentic-developer-handbook</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>lab-08-mcp</artifactId>
  <packaging>jar</packaging>

  <name>Lab 08 - MCP</name>
  <description>The Lab 07 bounded runtime, with one capability moved behind an MCP server in a separate process. MCP standardizes how the application reaches the capability; it does not create the agent.</description>

  <properties>
    <!-- Program arguments for exec:exec. Empty by default; the live run
         passes its flag through -Dexec.args, like the other labs. -->
    <exec.args></exec.args>
  </properties>

  <dependencies>
    <!-- Official MCP Java SDK, latest GA release (2.0.1). The "mcp" artifact is
         mcp-core plus its default JSON binding (Jackson 3); mcp-core alone has
         no JSON implementation, so this one coordinate is the smallest
         complete surface. It implements MCP specification 2025-11-25.
         Declared first so its Jackson annotations version (2.21) is the one
         resolved; google-genai's Jackson 2.17 works with it. -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp</artifactId>
      <version>2.0.1</version>
    </dependency>

    <!-- The MCP SDK logs through SLF4J. With no backend bound, SLF4J prints a
         warning into the middle of the lab's trace. This binds its
         no-operation provider on purpose: SDK-internal logs are discarded, and
         logging and tracing are Milestone 10. Same version as the slf4j-api
         that mcp-core brings. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>2.0.16</version>
      <scope>runtime</scope>
    </dependency>

    <!-- Official Google Gen AI Java SDK, only for the optional live run,
         kept at the same version as the other canonical labs. -->
    <dependency>
      <groupId>com.google.genai</groupId>
      <artifactId>google-genai</artifactId>
      <version>1.72.0</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.1.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.4</version>
        <!-- Run with exec:exec, not exec:java. The application launches the
             MCP server as a separate process with its own classpath, so it
             must itself run as an ordinary java process: exec:java runs inside
             Maven's JVM, where that classpath does not exist. This is exactly
             "java -classpath ... McpExample", using the JDK that runs Maven. -->
        <configuration>
          <executable>${java.home}/bin/java</executable>
          <commandlineArgs>-classpath %classpath dev.agentic.handbook.labs.mcp.McpExample ${exec.args}</commandlineArgs>
          <!-- Only so that exec:java, typed out of habit, explains itself. -->
          <mainClass>dev.agentic.handbook.labs.mcp.McpExample</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
