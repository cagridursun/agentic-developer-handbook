<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.agentic.handbook</groupId>
    <artifactId>agentic-developer-handbook</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>lab-11-security</artifactId>
  <packaging>jar</packaging>

  <name>Lab 11 - Security</name>
  <description>Application-owned security controls around the bounded agent: a model proposal passes argument validation, authorization, and approval before an in-memory tool executes, and every decision is recorded as a security event in a small trace.</description>

  <properties>
    <!-- A property, not plugin configuration, so that
         -Dexec.mainClass=... can select the opt-in vulnerable demo. -->
    <exec.mainClass>dev.agentic.handbook.labs.security.SecurityExample</exec.mainClass>
  </properties>

  <dependencies>
    <!-- No production dependency: the controls are plain Java, and the lab has
         no live model mode, so it needs no provider SDK. JUnit is the only
         test dependency, at the same version as the other labs. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.1.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.4</version>
      </plugin>
    </plugins>
  </build>
</project>
