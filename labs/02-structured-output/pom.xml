<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.agentic.handbook</groupId>
    <artifactId>agentic-developer-handbook</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>lab-02-structured-output</artifactId>
  <packaging>jar</packaging>

  <name>Lab 02 - Structured Output</name>
  <description>Schema-constrained model output deserialized into a Java record. Still not an agent.</description>

  <dependencies>
    <!-- Official Google Gen AI Java SDK, pinned below 2.0.0 as upstream advises. -->
    <dependency>
      <groupId>com.google.genai</groupId>
      <artifactId>google-genai</artifactId>
      <version>1.72.0</version>
    </dependency>

    <!-- Turns the model's JSON into the DevelopmentTask record. The JDK has no
         JSON parser, and Jackson is already the SDK's own JSON library, so this
         declares a direct dependency on something the lab code imports anyway. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.22.3</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.1.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.4</version>
        <configuration>
          <mainClass>dev.agentic.handbook.labs.structuredoutput.StructuredOutputExample</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
