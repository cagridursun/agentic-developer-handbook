<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.agentic.handbook</groupId>
    <artifactId>agentic-developer-handbook</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>lab-07-agent-runtime</artifactId>
  <packaging>jar</packaging>

  <name>Lab 07 - Agent Runtime</name>
  <description>A bounded model-influenced execution loop. The model suggests; the runtime owns execution and stopping. This is an agent.</description>

  <dependencies>
    <!-- Official Google Gen AI Java SDK, pinned below 2.0.0 as upstream advises,
         kept at the same version as the other canonical labs. -->
    <dependency>
      <groupId>com.google.genai</groupId>
      <artifactId>google-genai</artifactId>
      <version>1.72.0</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.1.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.4</version>
        <configuration>
          <mainClass>dev.agentic.handbook.labs.agentruntime.AgentRuntimeExample</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
