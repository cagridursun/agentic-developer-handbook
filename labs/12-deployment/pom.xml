<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.agentic.handbook</groupId>
    <artifactId>agentic-developer-handbook</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>lab-12-deployment</artifactId>
  <packaging>jar</packaging>

  <name>Lab 12 - Deployment</name>
  <description>Packages and runs the Lab 11 application boundary as one artifact: environment-driven validated configuration, liveness and readiness endpoints, graceful shutdown, and structured deployment events, with the same validation, authorization, and approval controls in front of every tool.</description>

  <properties>
    <exec.mainClass>dev.agentic.handbook.labs.deployment.DeploymentMain</exec.mainClass>
    <!-- Identifies which build produced the artifact. CI passes the commit; a
         local build keeps "local". It is baked into the jar at build time and
         cannot be changed by runtime configuration. -->
    <build.id>local</build.id>
    <!-- A fixed timestamp makes the jar reproducible: the same sources and the
         same build.id give the same bytes. -->
    <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
  </properties>

  <dependencies>
    <!-- The deployment starts the Lab 11 application boundary; it does not
         copy it, so a deployed application cannot drift from the tested one. -->
    <dependency>
      <groupId>dev.agentic.handbook</groupId>
      <artifactId>lab-11-security</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.1.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>lab-12-deployment</finalName>

    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>${exec.mainClass}</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <!-- Copies the one runtime dependency next to the jar, so target/ holds
           everything the runtime image needs: the jar and lib/. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>copy-runtime-dependencies</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
              <useBaseVersion>true</useBaseVersion>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Two test passes. The default pass runs before packaging. The
           artifact pass runs after it, because it inspects and starts the
           packaged jar. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <executions>
          <execution>
            <id>default-test</id>
            <configuration>
              <excludes>
                <exclude>**/*ArtifactTest.java</exclude>
              </excludes>
            </configuration>
          </execution>
          <execution>
            <id>artifact-tests</id>
            <phase>verify</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/*ArtifactTest.java</include>
              </includes>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.4</version>
      </plugin>
    </plugins>
  </build>
</project>
