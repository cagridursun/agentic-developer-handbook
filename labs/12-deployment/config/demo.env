# Sample configuration for the container demo. 0.0.0.0 is needed inside a container; publish the
# port on loopback only: docker run -p 127.0.0.1:8080:8080 --env-file labs/12-deployment/config/demo.env ...
# No secrets belong here. A secret such as APP_MONITORING_TOKEN is supplied at runtime, not in this file.
APP_ENV=demo
APP_PORT=8080
APP_BIND_ADDRESS=0.0.0.0
APP_LOG_LEVEL=INFO
APP_SHUTDOWN_GRACE_SECONDS=10
